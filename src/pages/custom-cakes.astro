---
import Base from '../layouts/Base.astro';
import BakeryCard from '../components/BakeryCard.astro';
import { getPublishedBakeries, placeLabel, formatDate } from '../lib/bakery';

const all = await getPublishedBakeries();
const takesCakes = all.filter((b) => b.data.customCakes === 'yes');
// A stated lead time or ordering process is worth surfacing even where we have not
// separately confirmed the bakery takes fully custom work.
const withLead = all.filter((b) => b.data.customCakeLeadTime || b.data.customCakeProcess);
const unconfirmed = all.filter(
  (b) => b.data.customCakes === 'unknown' && !b.data.customCakeProcess
);

const title = 'Custom cakes in Detroit: who takes orders and how far ahead | Detroit Bakery';
const description =
  'Which Detroit area bakeries take custom cake orders, the lead time each one states, and how each prefers to be contacted. Compiled from what the bakeries publish, with the date each was checked.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://detroitbakery.com/' },
    { '@type': 'ListItem', position: 2, name: 'Custom cakes', item: 'https://detroitbakery.com/custom-cakes/' },
  ],
};
---

<Base title={title} description={description} jsonLd={breadcrumb}>
  <nav class="wrap crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Custom cakes</li>
    </ol>
  </nav>

  <section class="wrap band" style="padding-bottom:0">
    <span class="eyebrow">ordering ahead</span>
    <h1>Custom cakes in Detroit</h1>
    <p class="lede" style="max-width:54ch">
      The question that decides everything is how far ahead you have to ask. Almost no
      bakery publishes it. Here is what we have confirmed.
    </p>

    <div class="callout">
      <p>
        <strong>The short version.</strong> Assume two weeks for a decorated cake and more
        for a wedding cake or a holiday weekend. The bakeries below that state a shorter
        window are stating a minimum for simpler orders, not a promise they can fit you in.
        Call before you plan around any of it.
      </p>
    </div>
  </section>

  {
    withLead.length > 0 && (
      <section class="wrap">
        <h2>Stated lead times</h2>
        <p>
          Each figure below is what the bakery itself publishes. Where a bakery gives a
          process rather than a number, we quote the process.
        </p>
        <div class="cmp-scroll">
          <table class="cmp">
            <thead>
              <tr>
                <th scope="col">Bakery</th>
                <th scope="col">Where</th>
                <th scope="col">Stated lead time</th>
                <th scope="col">How to order</th>
                <th scope="col">Checked</th>
              </tr>
            </thead>
            <tbody>
              {withLead.map((b) => (
                <tr>
                  <td>
                    <a href={`/bakeries/${b.data.slug}/`}>{b.data.name}</a>
                  </td>
                  <td>{placeLabel(b.data)}</td>
                  <td>{b.data.customCakeLeadTime ?? "Not stated"}</td>
                  <td>{b.data.customCakeProcess ?? 'Contact the bakery'}</td>
                  <td>{formatDate(b.data.verifiedOn)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    takesCakes.length > 0 && (
      <section class="wrap">
        <h2>Bakeries that take custom orders</h2>
        <ul class="grid">
          {takesCakes.map((b) => (
            <BakeryCard bakery={b} emphasis="cakes" />
          ))}
        </ul>
      </section>
    )
  }

  <section class="wrap narrow">
    <h2>What to have ready when you call</h2>
    <p>
      Bakeries can quote much faster when you lead with the constraints rather than the
      picture. Have these in hand:
    </p>
    <ul>
      <li>The date you need it, and whether you can collect it a day early.</li>
      <li>How many people it needs to serve, rather than a size in inches.</li>
      <li>Flavour of the cake and the filling, and anything you want avoided.</li>
      <li>Any allergy or dietary requirement, stated plainly and early.</li>
      <li>A budget range. It is not rude, and it saves both of you a round trip.</li>
      <li>One or two reference photos, not twenty.</li>
    </ul>

    <h2>On allergies</h2>
    <p>
      Several bakeries here offer vegan or gluten free items. That is a recipe statement,
      not an allergy statement. A kitchen that also handles wheat, nuts, dairy and egg
      cannot usually promise there is no cross contact. If someone eating the cake has a
      genuine allergy, ask the bakery directly how they handle it and decide based on their
      answer, not on a label on this site.
    </p>

    {
      unconfirmed.length > 0 && (
        <div class="note">
          <p>
            <strong>Not yet confirmed.</strong> We have{' '}
            {unconfirmed.length} {unconfirmed.length === 1 ? 'bakery' : 'bakeries'} in the
            guide where we have not yet confirmed whether custom orders are taken. Rather
            than guess, we leave it blank. If you know, or if you run one of them,{' '}
            <a href="/update-listing/">tell us</a>.
          </p>
        </div>
      )
    }
  </section>
</Base>
