---
import Base from '../layouts/Base.astro';
---
<Base
  title="Thank you | Detroit Bakery"
  description="Your message has been received."
  noindex={true}
>
  <section class="wrap narrow">
    <h1>Thank you</h1>
    <p class="lede">
      That came through. If it was a correction to a listing, we aim to have it applied
      within a week, and sooner if you told us you run the bakery.
    </p>
    <p><a class="btn" href="/bakeries/">Back to the bakeries</a></p>
  </section>
</Base>
