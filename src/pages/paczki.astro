---
import Base from '../layouts/Base.astro';
import BakeryCard from '../components/BakeryCard.astro';
import {
  getPublishedBakeries,
  placeLabel,
  formatDate,
  nextPaczkiDay,
  longDate,
} from '../lib/bakery';

const all = await getPublishedBakeries();
const paczkiPlaces = all.filter((b) => b.data.paczki === 'yes');
const yearRound = paczkiPlaces.filter((b) => b.data.paczkiYearRound === 'yes');
const withPrices = paczkiPlaces.filter((b) => b.data.priceExamples.length > 0);

const pd = nextPaczkiDay();
const year = pd.getUTCFullYear();

const title = `Paczki in Detroit: where to buy and when to order for ${year} | Detroit Bakery`;
const description = `Paczki Day ${year} is ${longDate(pd)}. Which Detroit and Hamtramck bakeries sell paczki, which sell them year round, published box prices, and what we know about ordering ahead.`;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://detroitbakery.com/' },
    { '@type': 'ListItem', position: 2, name: 'Paczki', item: 'https://detroitbakery.com/paczki/' },
  ],
};
---

<Base title={title} description={description} jsonLd={breadcrumb}>
  <nav class="wrap crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Paczki</li>
    </ol>
  </nav>

  <div class="folk-band" style="background-image:url('/img/wycinanki.jpg');border-top:0" role="presentation"></div>

  <section class="wrap band" style="padding-bottom:0">
    <span class="eyebrow">Hamtramck and beyond</span>
    <h1>P&#261;czki in Detroit</h1>
    <p class="lede">
      Paczki Day {year} falls on <strong>{longDate(pd)}</strong>. In this part of Michigan
      that is a genuine event rather than a novelty, and the bakeries that do it properly
      sell out. Here is what we have confirmed about who makes them, who makes them all
      year, and what they cost.
    </p>

    <div class="callout">
      <p>
        <strong>A pronunciation note, since it comes up.</strong> One is a paczek. More than
        one, which is the realistic case, are paczki. The Polish spelling uses a nasal
        hook: pączki.
      </p>
    </div>
  </section>

  {
    yearRound.length > 0 && (
      <section class="wrap">
        <h2>Sold year round, not just in February</h2>
        <p>
          This is the detail almost nobody publishes, and it matters if you want paczki in
          June. These bakeries state they sell them all year.
        </p>
        <ul class="grid">
          {yearRound.map((b) => (
            <BakeryCard bakery={b} emphasis="paczki" />
          ))}
        </ul>
      </section>
    )
  }

  {
    withPrices.length > 0 && (
      <section class="wrap">
        <h2>Published box options and prices</h2>
        <p>
          Copied as the bakery published them. Paczki pricing is set per season, so treat a
          price from a previous season as a guide to the order of magnitude rather than as
          this year's number.
        </p>
        {withPrices.map((b) => (
          <div>
            <h3 style="margin-top:1.6rem">
              <a href={`/bakeries/${b.data.slug}/`}>{b.data.name}</a>
              <span style="font-weight:400;color:var(--muted);font-size:0.95rem">
                {' '}
                · {placeLabel(b.data)}
              </span>
            </h3>
            <div class="cmp-scroll">
              <table class="cmp">
                <thead>
                  <tr>
                    <th scope="col">Box</th>
                    <th scope="col">Price</th>
                    <th scope="col">As published</th>
                  </tr>
                </thead>
                <tbody>
                  {b.data.priceExamples.map((p) => (
                    <tr>
                      <td>{p.item}</td>
                      <td>{p.price}</td>
                      <td>{p.asOf}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {b.data.hoursNote && <p>{b.data.hoursNote}</p>}
            <p class="stamp" style="border:0;padding-top:0.4rem">Checked {formatDate(b.data.verifiedOn)}</p>
          </div>
        ))}
      </section>
    )
  }

  {
    paczkiPlaces.length > 0 && (
      <section class="wrap">
        <h2>Every bakery we have confirmed sells paczki</h2>
        <ul class="grid">
          {paczkiPlaces.map((b) => (
            <BakeryCard bakery={b} emphasis="paczki" />
          ))}
        </ul>
      </section>
    )
  }

  <section class="wrap narrow">
    <h2>How to actually get them on the day</h2>
    <p>
      Fat Tuesday is the one day of the year when turning up casually does not work. The
      pattern in Hamtramck is that the serious bakeries open extremely early, the line
      forms before that, and popular fillings run out first.
    </p>
    <ul>
      <li>Order ahead if the bakery lets you. Pre-order windows tend to close days early.</li>
      <li>Check the special hours. Several bakeries open in the small hours on the day.</li>
      <li>Going late in the day is a gamble. Going at lunchtime for a specific filling is a bigger one.</li>
      <li>If the date is not the point for you, buy them from a year round bakery on a quiet Tuesday instead.</li>
    </ul>

    <div class="note">
      <p>
        <strong>Ahead of {year}.</strong> Most bakeries publish their box options and
        pre-order deadlines in January. We update this page when they do. If you run a
        bakery and want your {year} options listed,
        <a href="/update-listing/">send them to us</a> and we will add them, free.
      </p>
    </div>
  </section>
</Base>
